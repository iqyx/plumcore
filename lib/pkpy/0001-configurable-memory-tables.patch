+// Number of slots in the internal fixed-size hash tables: the global string interning
+// table (name.c) and the per-VM cached-names map (fixedhash.h). Both are indexed by the
+// low bits of a hash, so this MUST be a power of two. The default 0x10000 (64Ki) matches
+// upstream; the tables are statically allocated, so lowering this on a memory constrained
+// target cuts static RAM dramatically at the cost of more hash collisions.
+//   string table:  PK_HASH_TABLE_SIZE * sizeof(void*) bytes
+//   cached names:  PK_HASH_TABLE_SIZE * sizeof(uint16_t) bytes (per VM)
+#ifndef PK_HASH_TABLE_SIZE          // can be overridden by cmake
+#define PK_HASH_TABLE_SIZE          0x10000
+#endif
+#define PK_HASH_TABLE_MASK          (PK_HASH_TABLE_SIZE - 1)
+
+// Size in bytes of a single garbage-collected object arena. Arenas are allocated on the
+// heap on demand, so this is the granularity (and minimum footprint) of the GC heap. The
+// default 120 KiB is far larger than a small target's whole RAM; lower it accordingly.
+#ifndef PK_GC_ARENA_SIZE            // can be overridden by cmake
+#define PK_GC_ARENA_SIZE            (120 * 1024)
+#endif
+
+// Size in bytes of the statically allocated stdout buffer used by picoterm's full
+// buffering mode. Defaults to 32 KiB upstream.
+#ifndef PK_PICOTERM_BUF_SIZE        // can be overridden by cmake
+#define PK_PICOTERM_BUF_SIZE        (1024 * 32)
+#endif
+
 /*************** internal settings ***************/
 // This is the maximum character length of a module path
 #define PK_MAX_MODULE_PATH_LEN      63
