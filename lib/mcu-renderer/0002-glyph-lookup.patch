+def read_variable(data, index):
+    value = 0
+    while True:
+        byte = data[index]
+        index += 1
+        value = (value << 7) | (byte & 0x7f)
+        if not byte & 0x80:
+            return value, index
+
+
+def build_glyph_table(data):
+    # Walk the blocks of an encoded font and collect the offset of every glyph's data (past its size) from the
+    # start of the font. The table covers all codepoints from the lowest to the highest one, 0 marks a missing
+    # glyph.
+    offsets = {}
+    index = FONT_HEADER_SIZE
+    while True:
+        block_size, index = read_variable(data, index)
+        if block_size == 0:
+            break
+        codepoint, index = read_variable(data, index)
+        block_end = index + block_size
+        while index < block_end:
+            glyph_size, index = read_variable(data, index)
+            if index > 0xffff:
+                raise ValueError('font too large for a 16-bit glyph table')
+            offsets[codepoint] = index
+            index += glyph_size
+            codepoint += 1
+
+    first = min(offsets)
+    return first, [offsets.get(codepoint, 0) for codepoint in range(first, max(offsets) + 1)]
+
+
+def write_glyph_table_header(file, font, glyph_table):
+    define_name = font.variable_name.upper()
+    first, offsets = glyph_table
+
+    file.write(f'#define {define_name}_GLYPH_TABLE_FIRST {first}\n')
+    file.write(f'#define {define_name}_GLYPH_TABLE_COUNT {len(offsets)}\n\n')
+
+
+def write_encoded_font(font, encoded_font, path, extern_path, glyph_table=None):
     with open(path, 'w') as file:
