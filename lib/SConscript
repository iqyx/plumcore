Import("env")
Import("conf")
Import("objs")

import os

# The library-fetching helpers (env.Git/env.Patch/env.Make) are defined in lib.SConscript and
# env.Component / the SBOM registry in sbom.SConscript; both are sourced early from the top-level
# SConstruct so they are available to every library and service SConscript.

for d in next(os.walk("."))[1]:
	f = os.path.join(d, "SConscript")
	if os.path.isfile(f):
		SConscript(f)
