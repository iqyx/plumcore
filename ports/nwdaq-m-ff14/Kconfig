config PORT_NWDAQ_M_FF14
	bool "nwdaq-m-ff14 4-channel resistive force sensor digitizer"

	menu "Configuraton"
		depends on PORT_NWDAQ_M_FF14

		config PORT_NAME
			string
			default "nwdaq-m-ff14"

		config PLATFORM_NAME
			string
			default "cortex-m4f"

		config MCU_FAMILY
			string
			default "stm32g4"

		config PORT_FLASH_ADDRESS
			hex
			default "0x08000000"

		config PORT_NWDAQ_M_FF14_MIB_PUBKEY
			string "Ed25519 public key for MIB verification (base64)"
			default ""
	endmenu
