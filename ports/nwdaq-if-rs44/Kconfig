config PORT_NWDAQ_IF_RS44
	bool "nwdaq-ir-rs44 RS485 interface"

	menu "Configuraton"
		depends on PORT_NWDAQ_IF_RS44

		config PORT_NAME
			string
			default "nwdaq-if-rs44"

		config PLATFORM_NAME
			string
			default "cortex-m4f"

		config MCU_FAMILY
			string
			default "stm32g4"

		config PORT_FLASH_ADDRESS
			hex
			default "0x08000000"
	endmenu
