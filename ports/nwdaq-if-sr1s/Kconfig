config PORT_NWDAQ_IF_SR1S
	bool "nwdaq-if-sr1s short-range interface with a 10Base-T1S switch"

	menu "Configuraton"
		depends on PORT_NWDAQ_IF_SR1S

		config PORT_NAME
			string
			default "nwdaq-if-sr1s"

		config PLATFORM_NAME
			string
			default "cortex-m4f"

		config MCU_FAMILY
			string
			default "stm32g4"

		config PORT_FLASH_ADDRESS
			hex
			default "0x08000000"

		config PORT_NWDAQ_IF_SR1S_MIB_PUBKEY
			string "Ed25519 public key for MIB verification (base64)"
			default ""
	endmenu
